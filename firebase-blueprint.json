{
  "entities": {
    "User": {
      "title": "User",
      "description": "Store registered users and their general roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date" }
      },
      "required": ["uid", "email"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Store tournaments with their full configs, athletes, and real-time scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matchName": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date" },
        "updatedAt": { "type": "string", "format": "date" },
        "referees": { "type": "array" },
        "subAdmins": { "type": "array" },
        "isPublic": { "type": "boolean" },
        "competitionMode": { "type": "string" },
        "shotsCount": { "type": "number" },
        "teamShotsCount": { "type": "number" },
        "directMaxPoints": { "type": "number" },
        "teamDirectMaxPoints": { "type": "number" },
        "distances": { "type": "array" },
        "teamDistances": { "type": "array" },
        "athletes": { "type": "array" },
        "teamAthletes": { "type": "array" },
        "inputAthletes": { "type": "array" },
        "teamInputAthletes": { "type": "array" }
      },
      "required": ["id", "matchName", "creatorId", "creatorEmail"]
    },
    "VscSystemAthletes": {
      "title": "VscSystemAthletes",
      "description": "Global list of VSC system athletes",
      "type": "object",
      "properties": {
        "athletes": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date" }
      },
      "required": ["athletes"]
    },
    "Club": {
      "title": "Club",
      "description": "Global official club of the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "province": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorEmail": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "PKChallenge": {
      "title": "PKChallenge",
      "description": "Represents a 1v1 or team match challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "teamSize": { "type": "number" },
        "title": { "type": "string" },
        "rules": { "type": "string" },
        "dateTime": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "challengerUid": { "type": "string" },
        "challengerName": { "type": "string" },
        "challengerAvatar": { "type": "string" },
        "challengerMembers": { "type": "array" },
        "opponentUid": { "type": "string" },
        "opponentName": { "type": "string" },
        "opponentAvatar": { "type": "string" },
        "opponentMembers": { "type": "array" }
      },
      "required": ["id", "type", "title", "status", "challengerUid", "challengerName"]
    },
    "TrainingSession": {
      "title": "TrainingSession",
      "description": "Store a user's local slingshot practice history sessions (Target and Paper targets)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "targetType": { "type": "string" },
        "distance": { "type": "number" },
        "targetShots": { "type": "number" },
        "shots": { "type": "array" },
        "hitsCount": { "type": "number" },
        "missesCount": { "type": "number" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "accuracy": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date" }
      },
      "required": ["id", "userId", "date", "targetType", "distance", "targetShots", "accuracy"]
    },
    "DirectChat": {
      "title": "DirectChat",
      "description": "Represents a private direct message chat session between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array" },
        "updatedAt": { "type": "string" },
        "lastMessage": { "type": "object" },
        "unreadCount": { "type": "object" }
      },
      "required": ["id", "participants"]
    },
    "DirectChatMessage": {
      "title": "DirectChatMessage",
      "description": "An individual chat message in a direct message session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "senderId", "text", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "#/entities/User",
      "description": "Registered user profile information"
    },
    "tournaments/{tournamentId}": {
      "schema": "#/entities/Tournament",
      "description": "Active slingshot tournament and shooting configuration details"
    },
    "vsc_system_athletes/{documentId}": {
      "schema": "#/entities/VscSystemAthletes",
      "description": "Global official roster of pre-approved athletes"
    },
    "vsc_system_clubs/{clubId}": {
      "schema": "#/entities/Club",
      "description": "Global official list of clubs"
    },
    "vsc_pk_challenges/{challengeId}": {
      "schema": "#/entities/PKChallenge",
      "description": "List of active and historical PK match challenges"
    },
    "vsc_training_sessions/{sessionId}": {
      "schema": "#/entities/TrainingSession",
      "description": "User specific personal slingshot training logs"
    },
    "vsc_chats/{chatId}": {
      "schema": "#/entities/DirectChat",
      "description": "Direct message chat session documents"
    },
    "vsc_chats/{chatId}/messages/{messageId}": {
      "schema": "#/entities/DirectChatMessage",
      "description": "Messages inside a direct message session"
    }
  }
}
